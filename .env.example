# Private market engine
MARKET_API_HOST=127.0.0.1
MARKET_API_PORT=8010

# Final strategic market. Historical experiments pass their own config path.
MARKET_CONFIG_PATH=configs/market_v10_multi_objective.yaml

# Read/intent-only Agent Gateway
MARKET_AGENT_GATEWAY_ENABLED=1
MARKET_AGENT_HOST=127.0.0.1
MARKET_AGENT_PORT=8011

# Replace locally. Never commit the real token.
MARKET_CONTROLLER_TOKEN=replace-with-a-random-high-entropy-token

# Local demonstration only. Keep disabled on any non-loopback deployment.
MARKET_LOCAL_DEV_UNAUTHENTICATED_CONTROLLER=0

# Select doubao, deepseek, or mock. CLI --provider overrides this value.
AGENT_PROVIDER=doubao

# Agent-side PersonaProfile. CLI --persona overrides this value.
AGENT_PERSONA=balanced

# Volcengine Ark / Doubao. Never commit a real API key.
ARK_API_KEY=replace-with-your-local-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=replace-with-your-local-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
